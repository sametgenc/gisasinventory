DATABASE_URL=postgres://prod_user:prod_password@postgres:5432/myproject_prod
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DOMAIN=example.co

# Production startup requires a Turnstile widget configured for this hostname.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=example.co
CROSS_TENANT_SHARING_ENABLED=false
# Optional for all accounts. Set true only to require administrator MFA.
ADMIN_REQUIRE_MFA=false

# Durable audit collection is always enabled. Enable HTTPS delivery after
# configuring your SIEM collector; the collector must deduplicate event UUIDs.
AUDIT_SIEM_ENABLED=false
AUDIT_SIEM_URL=
AUDIT_SIEM_TOKEN=

# SMTP can be configured in Platform > Settings. Saved values take precedence.
EMAIL_BACKEND=apps.settings.email_backend.DatabaseEmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.co

# Generate separate Fernet keys once and keep them with your backups.
# Blank keys derive from DJANGO_SECRET_KEY; rotating it then requires re-entering secrets.
SMTP_CREDENTIAL_KEY=
MFA_CREDENTIAL_KEY=
